# Supabase (proyecto de dev primero; luego producción, ver docs/PRD-agendamiento.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existente (no relacionado con agendamiento, dejar como está)
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Notificaciones (ver docs/PRD-notificaciones.md → "Puesta en marcha")
# ---------------------------------------------------------------------------
# Todo esto es OPCIONAL: sin estas variables la aplicación funciona completa.
# Lo único que cambia es que las notificaciones de correo quedan en estado
# OMITIDO, con el motivo visible en /admin/notificaciones → Historial.

# API key de Resend (https://resend.com → API Keys). Empieza por "re_".
# Sin ella no se envía ningún correo.
RESEND_API_KEY=

# Remitente de los correos. El dominio TIENE que estar verificado en Resend
# (registros DNS), si no Resend rechaza el envío.
# Formato: Nombre visible <direccion@tudominio.com>
RESEND_FROM=

# Clave compartida con Vercel Cron para autenticar /api/cron/notificaciones.
# Genérala con: openssl rand -hex 32
# Sin ella la ruta responde 401 y no corren recordatorios ni cumpleaños.
CRON_SECRET=

# URL pública del sitio (https://...), usada en enlaces absolutos.
NEXT_PUBLIC_SITE_URL=
